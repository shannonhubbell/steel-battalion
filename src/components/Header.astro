---
import Decider from "../assets/decider.webp";
---

<header id="page-header">
    <div class="layout">
        <div class="bsbb-logo crt-filter glitch-text">
            <h1>
                <span class="row" style="--char-count: 3"
                    ><span class="wrap">Big</span></span
                >
                <span class="row" style="--char-count: 6"
                    ><span class="wrap">Steel</span></span
                >
                <span class="row" style="--char-count: 9"
                    ><span class="wrap">Battalion</span></span
                >
                <span class="row" style="--char-count: 7"
                    ><span class="wrap">Box MkII</span></span
                >
            </h1>
        </div>
        <img
            src={Decider.src}
            alt="Crazy military mech, The Decider"
            class="decider"
            data-aos="fade-left"
            data-aos-delay="300"
        />
        <h2>Come to the <a href="https://themade.org" target="_blank">MADE</a> for the ultimate in immersive mech combat.</h2>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" version="1.1" class="pixelate-svg">
        <filter id="pixelate" x="0" y="0">
            <!-- Define the size of the pixel blocks (e.g., width 5, height 5) -->
            <feFlood x="2" y="2" height="2" width="1"></feFlood>
            <feComposite width="5" height="5"></feComposite>
            <feTile result="t"></feTile>
            <feComposite in="SourceGraphic" in2="t" operator="in"></feComposite>
            <feMorphology operator="dilate" radius="2"></feMorphology>
        </filter>
    </svg>
</header>
<style>
    .pixelate-svg {
        position: absolute;
        width: 0;
        height: 0;
        visibility: hidden;
    }
    .pixelated-target {
        filter: url("#pixelate");
    }
    #page-header {
        position: relative;
        width: 100%;
        text-align: center;
        border-bottom: 25px solid #000;
        padding: 3rem 0;
        .decider {
            position: absolute;
            transform: scaleX(-1);
            top: 0;
            right: 0;
        }
        &::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background-image: url(../assets/banner-photo.webp);
            background-size: cover;
            background-position: bottom;
            z-index: 0;
            filter: saturate(2) contrast(0.5);
        }
        .bsbb-logo {
            display: flex;
            flex-direction: column;
            justify-content: center;
            width: 500px;
            max-width: 100%;
            height: auto;
            aspect-ratio: 1/1;
            padding: 20px 0;
            z-index: 2;
            position: relative;
            background: #000;
            border-radius: 50%;
            overflow: hidden;
        }

        /* Fancy Pants LOGO */
        h1 {
            width: 500px;
            display: flex;
            max-width: 100%;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            display: flex;

            background-image: linear-gradient(
                45deg,
                #fff,
                var(--BATTALION-color)
            );
            background-clip: text;
            color: transparent;
            .row {
                container-type: inline-size;
                width: 100%;
                display: block;
                line-height: 0.6;
                .wrap {
                    text-align: center;
                    display: block;
                    white-space: nowrap;
                    font-size: calc(100cqi / var(--char-count, 10));
                }
            }
        }

        h2 {
            position: relative;
            text-align: right;
            display: inline-block;
            padding: 2rem;
            background: #000;
            float: right;
            font-size: 2rem;
            max-width: 50%;
            text-wrap: pretty;
            transform: translateY(-25%);
            @media screen and (max-width: 750px) {
                float: none;
                display: block;
                transform: none;
                max-width: 100%;
                text-align: left;
            }
            a {
                color: #FFF;
            }
        }

    }
</style>
